{
  "name": "mobile-tutor-rn",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "overrides": {
    "@react-native/babel-preset": {
      "hermes-parser": "0.36.1",
      "babel-plugin-syntax-hermes-parser": "0.36.1"
    }
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "jest --watchAll",
    "test:coverage": "jest --coverage",
    "lint": "eslint src tools --max-warnings 0",
    "type-check": "tsc --noEmit",
    "check:colors": "! grep -rn '\"#' src/components/ src/app/",
    "check:no-ocean": "! grep -rn '\"#1A3A52\"' src/"
  },
  "dependencies": {
    "@expo-google-fonts/cormorant": "0.2.3",
    "@expo-google-fonts/jetbrains-mono": "0.2.3",
    "@expo-google-fonts/lexend": "0.2.3",
    "@hookform/resolvers": "5.2.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "8.4.4",
    "@tanstack/query-async-storage-persister": "5.100.10",
    "@tanstack/react-query": "5.100.10",
    "@tanstack/react-query-persist-client": "5.100.10",
    "axios": "1.16.1",
    "expo": "~54.0.0",
    "expo-clipboard": "~8.0.8",
    "expo-constants": "~18.0.13",
    "expo-font": "~14.0.11",
    "expo-image-picker": "~16.0.0",
    "expo-linear-gradient": "~15.0.8",
    "expo-linking": "~8.0.12",
    "expo-notifications": "~0.31.0",
    "expo-router": "~6.0.23",
    "expo-secure-store": "~15.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-hook-form": "7.75.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "4.1.6",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-worklets": "0.5.1",
    "zod": "4.4.3",
    "zustand": "5.0.13"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@testing-library/react-native": "^12.4.0",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.1.0",
    "@types/react-test-renderer": "~19.0.0",
    "babel-plugin-module-resolver": "^5.0.0",
    "babel-plugin-syntax-hermes-parser": "^0.36.1",
    "babel-preset-expo": "~54.0.10",
    "eslint": "^9.39.5",
    "eslint-config-expo": "10.0.0",
    "eslint-import-resolver-typescript": "3.10.1",
    "hermes-parser": "^0.36.1",
    "jest": "^29.0.0",
    "jest-expo": "~54.0.0",
    "typescript": "^5.3.0"
  },
  "jest": {
    "preset": "jest-expo",
    "globalSetup": "<rootDir>/jest.global-setup.js",
    "testTimeout": 20000,
    "cacheDirectory": "<rootDir>/.jest-cache",
    "coverageThreshold": {
      "global": {
        "statements": 78,
        "branches": 64,
        "functions": 80,
        "lines": 81
      }
    },
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.js"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1",
      "^@components/(.*)$": "<rootDir>/src/components/$1",
      "^@services/(.*)$": "<rootDir>/src/services/$1",
      "^@hooks/(.*)$": "<rootDir>/src/hooks/$1",
      "^@theme/(.*)$": "<rootDir>/src/theme/$1",
      "^@types$": "<rootDir>/src/types",
      "^@mocks/(.*)$": "<rootDir>/src/mocks/$1"
    },
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@unimodules/.*|unimodules|sentry-expo|native-base|react-native-svg|@tanstack|zustand|zod|axios)"
    ]
  }
}
