{
  "expo": {
    "name": "KURA Tutor",
    "slug": "mobile-tutor-rn",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "kura",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.kura.tutor"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F8F2E6"
      },
      "package": "com.kura.tutor"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#F8F2E6",
          "dark": {
            "image": "./assets/splash-icon-dark.png",
            "backgroundColor": "#14110C"
          }
        }
      ],
      "expo-font",
      [
        "expo-notifications",
        {
          "color": "#4A6944"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "c5320cbf-2427-4ac1-b095-887638bfcbd9"
      }
    }
  }
}
