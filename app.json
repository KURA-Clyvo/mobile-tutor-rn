{
  "expo": {
    "name": "KURA Tutor",
    "slug": "mobile-tutor-rn",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "kura",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F8F2E6"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.kura.tutor"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F8F2E6"
      },
      "package": "com.kura.tutor"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-notifications",
        {
          "color": "#4A6944"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
