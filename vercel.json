{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci",
  "buildCommand": "npx expo export -p web --clear && mv dist/assets/node_modules dist/assets/nm",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/assets/node_modules/:path*",
      "destination": "/assets/nm/:path*"
    },
    {
      "source": "/proxy/tutor/:path*",
      "destination": "https://SUBSTITUIR-PELO-TUNEL.trycloudflare.com/tutor/:path*"
    },
    {
      "source": "/proxy/luna/:path*",
      "destination": "https://SUBSTITUIR-PELO-TUNEL.trycloudflare.com/luna/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
